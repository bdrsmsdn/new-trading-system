# Hermes Trader Environment Configuration
# =========================================

# Binance Configuration
# Set TESTNET=true to use Binance Testnet (for testing without real money)
TESTNET=false

# Binance API Credentials
API_KEY=<YOUR_BINANCE_API_KEY>
API_SECRET=<YOUR_BINANCE_API_SECRET>

# Binance uses USDT pairs (e.g., BTCUSDT, DOGEUSDT)
PAIR=btcusdt

# Telegram Bot Configuration (optional - leave empty to disable)
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>

# MiniMax AI Agent (Anthropic-compatible)
MINIMAX_API_KEY=<YOUR_MINIMAX_API_KEY>

# Nonce file path
NONCE_FILE=.nonce
